<Window x:Class="ArchiveApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="أداة الأرشفة" Height="450" Width="700" MinHeight="420" MinWidth="620">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="اختر الملفات التي تريد أرشفتها" FontSize="18" FontWeight="Bold" />

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Width="140" HorizontalAlignment="Right" Margin="8,0,0,0">
                    <Button x:Name="AddFilesButton" Content="إضافة ملفات" Margin="0,0,0,8" Click="AddFilesButton_Click" />
                    <Button x:Name="RemoveSelectedButton" Content="حذف المحدد" Margin="0,0,0,8" Click="RemoveSelectedButton_Click" />
                    <Button x:Name="ClearButton" Content="مسح القائمة" Click="ClearButton_Click" />
                </StackPanel>
                <ListBox x:Name="FilesList" BorderThickness="0" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="مسار ملف الأرشيف الناتج" Margin="0,0,0,4" />
                <TextBox x:Name="DestinationPathBox" Height="30" Padding="6" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="PickDestinationButton" Content="اختيار" Padding="14,6" Click="PickDestinationButton_Click" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Margin="0,0,12,0" Width="160">
                <TextBlock Text="مستوى الضغط" Margin="0,0,0,4" />
                <ComboBox x:Name="CompressionLevelBox" SelectedIndex="1">
                    <ComboBoxItem Content="بدون ضغط" Tag="None" />
                    <ComboBoxItem Content="سريع" Tag="Fastest" />
                    <ComboBoxItem Content="متوازن" Tag="Optimal" />
                </ComboBox>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center" Foreground="#444" TextWrapping="Wrap" />
            <Button Grid.Column="2" x:Name="ArchiveButton" Content="إنشاء الأرشيف" Padding="14,6" Click="ArchiveButton_Click" />
        </Grid>
    </Grid>
</Window>
